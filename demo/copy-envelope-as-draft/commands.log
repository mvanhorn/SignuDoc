# Copy to new draft — live demo against local Postgres
# 2026-11-14T01:18:28Z
# APP_URL=http://127.0.0.1:3000
# EMAIL_DRIVER=capture STORAGE_DRIVER=local

$ curl -sS -o /dev/null -w icon.svg HTTP %{http_code}\n http://127.0.0.1:3000/icon.svg
icon.svg HTTP 200
exit=0

$ node /workspace/.data/demo/run-demo.mjs
